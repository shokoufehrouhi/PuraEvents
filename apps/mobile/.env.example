EXPO_PUBLIC_PEXELS_API_KEY=your_pexels_api_key_here

# RevenueCat public SDK keys (Project settings → API keys). Products expected
# in the stores, all attached to one entitlement "pro" and the "current"
# offering's monthly/annual/lifetime packages:
#   App Store:   puraevents_pro_monthly, puraevents_pro_yearly (7-day free trial intro offer), puraevents_pro_lifetime
#   Google Play: subscription puraevents_pro with base plans "monthly" and "yearly"
#                (+ a 7-day free-trial offer on yearly), one-time product puraevents_pro_lifetime
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_key_here

# Dev builds only: 1 = treat this device as Pro without a purchase.
EXPO_PUBLIC_FORCE_PRO=0
