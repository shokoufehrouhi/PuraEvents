{
  "expo": {
    "name": "PuraEvents",
    "slug": "puraevents",
    "scheme": "puraevents",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.puraapps.puraevents",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.puraapps.puraevents.widget"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "com.android.launcher.permission.INSTALL_SHORTCUT",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "package": "com.puraapps.puraevents",
      "versionCode": 16
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6558D9",
          "sounds": [
            "./assets/sounds/chime.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/ping.wav",
            "./assets/sounds/pulse.wav"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set a custom widget background."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 30
          }
        }
      ],
      "expo-sharing",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CountdownWidgetSmall",
              "label": "PuraEvents Countdown",
              "description": "See how many days are left until your next event, right on your home screen.",
              "minWidth": "165dp",
              "minHeight": "165dp",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone to record a voice message for the shared card."
        }
      ],
      [
        "react-native-share",
        {
          "ios": [],
          "android": []
        }
      ],
      "./plugins/withShareDownloadPaths",
      "./plugins/withReleaseSigning",
      "./plugins/withBackupRules",
      [
